<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Твоя валентинка — интерактив</title>
  <style>
    :root{
      --bg:#fff4f8; --accent:#ff2f5f; --muted:#6b6b6b; --card:#fff; 
      --max-width:980px; --glass: rgba(255,255,255,0.7);
      font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }
    html,body{height:100%;margin:0;background:linear-gradient(180deg,#fff4f8 0%, #ffeef6 100%);display:flex;align-items:center;justify-content:center}
    .page{width:calc(100% - 40px);max-width:var(--max-width);background:var(--glass);border-radius:18px;box-shadow:0 20px 60px rgba(0,0,0,0.10);overflow:hidden;position:relative}
    header{padding:22px 28px;display:flex;align-items:center;gap:14px}
    h1{margin:0;color:var(--accent);font-size:20px}
    main{padding:22px}
    .center{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
    button.primary{background:var(--accent);color:white;border:none;padding:12px 22px;border-radius:12px;font-size:18px;cursor:pointer}
    button.ghost{background:transparent;border:2px solid rgba(255,59,107,0.12);padding:10px 16px;border-radius:10px}
    .screen{display:none;padding:18px}
    .screen.active{display:block}
    #gameArea{position:relative;height:260px;border-radius:12px;background:linear-gradient(180deg,#fff 0%,#fff5f8 100%);overflow:hidden}
    .heart{position:absolute;width:52px;height:52px;cursor:pointer;transform:translate(-50%,-50%);transition:transform 0.14s ease, filter 140ms}
    .heart.gold{font-size:58px;filter:drop-shadow(0 6px 18px rgba(255,180,90,0.25))}
    .hud{display:flex;gap:12px;align-items:center;margin-top:12px;justify-content:center}
    .inputRow{display:flex;gap:8px;justify-content:center;margin-top:12px}
    input[type=text]{padding:10px;border-radius:10px;border:1px solid #eee;min-width:250px}
    .ynWrap{display:flex;gap:18px;align-items:center;justify-content:center;margin-top:18px}
    #noBtn{opacity:0.9;filter:grayscale(0.1)}
    #yesBtn{background:var(--accent);color:#fff;padding:12px 24px;border-radius:999px;border:none;font-weight:700;cursor:pointer;transition:transform 140ms ease, box-shadow 120ms ease}
    .slideshow{max-width:760px;margin:0 auto;border-radius:12px;overflow:hidden;position:relative}
    .slides{display:flex;transition:transform .6s ease}
    .slide{min-width:100%;height:360px;background-position:center;background-size:cover}
    .slideNav{position:absolute;left:0;right:0;bottom:12px;display:flex;justify-content:center;gap:8px}
    .dot{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,0.8);opacity:0.6}
    .dot.active{transform:scale(1.2);opacity:1}
    .letter{padding:18px;border-radius:10px;background:linear-gradient(180deg,rgba(255,59,107,0.06),rgba(255,59,107,0.02));margin-top:12px;opacity:0;transform:translateY(6px);transition:opacity .5s ease, transform .5s ease}
    .letter.visible{opacity:1;transform:translateY(0)}
    footer{padding:14px;text-align:center;color:var(--muted);font-size:14px}
    .playerWrap{display:flex;gap:10px;align-items:center;margin-left:auto}
    .playerControls{display:none;align-items:center;gap:10px}
    .playerControls button{padding:8px 10px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);background:white}
    .volume{width:120px}
    .wordPopup{position:absolute;pointer-events:none;font-weight:700;color:#ff2f5f;text-shadow:0 2px 6px rgba(0,0,0,0.12);transform:translate(-50%,0);opacity:0;transition:opacity .45s, transform .45s}
    .revealBox{max-width:700px;margin:0 auto;padding:22px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.85),rgba(255,255,255,0.95));box-shadow:0 8px 30px rgba(0,0,0,0.06)}
    .typewriter{font-size:22px;color:#333;min-height:40px}
    #countdown{display:flex;align-items:center;justify-content:center;flex-direction:column}
    .countBox{width:180px;height:180px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,#fff 0%,#ffeef6 100%);box-shadow:0 10px 30px rgba(255,59,107,0.08);font-size:48px;color:var(--accent);font-weight:800}
    .countLabel{margin-top:12px;color:var(--muted)}
    #bgHearts{position:fixed;left:0;top:0;width:100%;height:100%;pointer-events:none;z-index:1}
    @media (max-width:640px){.page{border-radius:12px} #gameArea{height:200px} .slide{height:240px} .letter{font-size:15px} .playerControls{display:flex;flex-direction:column;align-items:flex-end} .countBox{width:140px;height:140px;font-size:40px}}
  </style>
</head>
<body>
  <canvas id="bgHearts"></canvas>
  <div class="page" role="application" aria-label="Интерактивная валентинка">
    <header>
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden>
        <path d="M12 21s-7.5-4.35-9.5-7.25C-0.85 8.55 5 3.5 8.5 6.25 10.2 7.6 12 9 12 9s1.8-1.4 3.5-2.75C19 3.5 24.85 8.55 21.5 13.75 19.5 16.65 12 21 12 21z" fill="#FF4D6D"/>
      </svg>
      <div>
        <h1>Для моей единственной</h1>
        <div style="color:var(--muted)">Проходи этапы — и ты увидишь моё письмо.</div>
      </div>
      <div class="playerWrap">
        <button id="musicToggle" class="ghost" title="Показать/скрыть плеер">Плеер</button>
        <div id="playerControls" class="playerControls">
          <button id="playBtn" class="ghost">▶︎</button>
          <button id="pauseBtn" class="ghost">❚❚</button>
          <button id="stopBtn" class="ghost">■</button>
          <input id="volRange" class="volume" type="range" min="0" max="100" value="45" aria-label="Громкость" />
        </div>
      </div>
    </header>
    <main>
      <section id="landing" class="screen active center">
        <h2>Хочешь сыграть?</h2>
        <p>Нажми <strong>Начать</strong> — будет мило, весело и романтически ❤️</p>
        <button id="startBtn" class="primary">Начать</button>
      </section>
      <section id="game" class="screen">
        <h3 class="center">Поймай <span id="targetNum">6</span> сердечек!</h3>
        <div id="gameArea" aria-live="polite"></div>
        <div class="hud">
          <div>Собрано: <strong id="score">0</strong></div>
          <div>Осталось: <strong id="left">6</strong></div>
        </div>
        <div class="center">
          <button id="restartGame" class="ghost">Перезапустить</button>
        </div>
      </section>
      <section id="secret" class="screen center">
        <h3>Секретный вопрос</h3>
        <p>Введи ответ, который знаешь только ты.</p>
        <div class="inputRow">
          <input id="secretInput" type="text" placeholder="Тут твой ответ" aria-label="Секретный ответ" />
          <button id="secretCheck" class="primary">Проверить</button>
        </div>
        <div id="secretMsg" style="margin-top:10px;color:var(--muted)"></div>
      </section>
      <section id="password" class="screen center">
        <h3>Пароль</h3>
        <p>Напиши пароль, который ты точно знает.</p>
        <div class="inputRow">
          <input id="passInput" type="text" placeholder="Пароль" aria-label="Пароль" />
          <button id="passCheck" class="primary">Ввести</button>
        </div>
        <div id="passMsg" style="margin-top:10px;color:var(--muted)"></div>
      </section>
      <section id="countdown" class="screen center">
        <div class="countBox" id="countValue">5</div>
        <div class="countLabel">Скоро узнаешь... <button id="skipTimer" class="ghost">Пропустить</button></div>
      </section>
      <section id="reveal" class="screen center">
        <div class="revealBox">
          <div class="typewriter" id="typewriter"> </div>
          <div style="margin-top:12px;color:var(--muted)">Подожди немного...</div>
        </div>
      </section>
      <section id="final" class="screen center">
        <h3>Будешь ли ты моей валентинкой?</h3>
        <div class="ynWrap">
          <button id="yesBtn">ДА 💕</button>
          <button id="noBtn">НЕТ</button>
        </div>
      </section>
      <section id="slideshow" class="screen center">
        <h3>Для тебя — моё письмо</h3>
        <div class="slideshow" aria-live="polite">
          <div class="slides" id="slides">
            <div class="slide" style="background-image:url('https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=1400&q=80&auto=format&fit=crop')"></div>
            <div class="slide" style="background-image:url('https://images.unsplash.com/photo-1502720705749-3c0bdf7a6e6b?w=1400&q=80&auto=format&fit=crop')"></div>
            <div class="slide" style="background-image:url('https://images.unsplash.com/photo-1517423440428-a5a00ad493e8?w=1400&q=80&auto=format&fit=crop')"></div>
          </div>
          <div class="slideNav" id="dots"></div>
        </div>
        <div class="letter" id="letter">
          <p>Милая,</p>
          <p>Я сделал для тебя этот маленький мир — чтобы ты улыбнулась. Спасибо, что ты есть. Ты — лучшая часть моих дней; когда ты рядом, всё кажется проще и светлее.</p>
          <p>С любовью,</p>
          <p><strong>Твой...</strong></p>
        </div>
      </section>
    </main>
    <footer>Подставь свои ответы в константы вверху скрипта (SECRET_ANSWER и KNOWN_PASSWORD) перед публикацией.</footer>
  </div>
  <canvas id="confettiCanvas" style="position:fixed;left:0;top:0;pointer-events:none;z-index:9999;display:none"></canvas>
  <script>
  const SECRET_ANSWER = "всегда";
  const KNOWN_PASSWORD = "0609";
  const GAME_TARGET = 6;
  const COUNTDOWN_SECONDS = 5;
  const MUSIC_URL = null;
  const MUSIC_SC_URL = 'https://on.soundcloud.com/tFbENq1oxZkkIxsquj';
  const FLOATING_WORDS = ['улыбка','обниму','тёпло','счастье','поцелуй','люблю','твой смех','навсегда'];

  let gameStarted = false, scReady = false, scPlaying = false, scWidget = null, bgm = null;

  const bgCanvas = document.getElementById('bgHearts');
  const bgCtx = bgCanvas.getContext('2d');
  let bgParticles = [];
  
  function resizeBg() {
    bgCanvas.width = window.innerWidth;
    bgCanvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resizeBg);
  resizeBg();
  
  function spawnBgParticle() {
    bgParticles.push({
      x: Math.random() * bgCanvas.width,
      y: -20,
      vx: (Math.random() - 0.5) * 0.3,
      vy: 0.3 + Math.random() * 0.6,
      size: 8 + Math.random() * 14,
      rot: Math.random() * 360,
      vr: (Math.random() - 0.5) * 0.6,
      alpha: 0.5 + Math.random() * 0.5
    });
  }
  
  for (let i = 0; i < 30; i++) spawnBgParticle();
  
  function bgTick() {
    bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);
    for (let i = 0; i < bgParticles.length; i++) {
      const p = bgParticles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.rot += p.vr;
      bgCtx.save();
      bgCtx.globalAlpha = p.alpha;
      bgCtx.translate(p.x, p.y);
      bgCtx.rotate(p.rot * Math.PI / 180);
      bgCtx.beginPath();
      bgCtx.moveTo(0, 0);
      bgCtx.fillStyle = 'rgba(255,77,109,' + p.alpha + ')';
      bgCtx.arc(-p.size * 0.3, 0, p.size * 0.45, 0, Math.PI * 2);
      bgCtx.arc(p.size * 0.3, 0, p.size * 0.45, 0, Math.PI * 2);
      bgCtx.moveTo(-p.size, 0);
      bgCtx.quadraticCurveTo(0, p.size * 1.2, p.size, 0);
      bgCtx.fill();
      bgCtx.restore();
      if (p.y > bgCanvas.height + 40) {
        bgParticles.splice(i, 1);
        i--;
      }
    }
    if (Math.random() < 0.06) spawnBgParticle();
    requestAnimationFrame(bgTick);
  }
  requestAnimationFrame(bgTick);

  const screens = () => document.querySelectorAll('.screen');
  function show(id) {
    screens().forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
  }

  const musicToggle = document.getElementById('musicToggle');
  if (MUSIC_URL) {
    bgm = new Audio(MUSIC_URL);
    bgm.loop = true;
    bgm.volume = 0.45;
  }
  if (MUSIC_SC_URL) {
    const scIframe = document.createElement('iframe');
    scIframe.id = 'sc-player-iframe';
    scIframe.style.display = 'block';
    scIframe.width = '300';
    scIframe.height = '80';
    scIframe.frameBorder = '0';
    scIframe.allow = 'autoplay';
    scIframe.src = 'https://w.soundcloud.com/player/?url=' + encodeURIComponent(MUSIC_SC_URL) + '&auto_play=false&hide_related=false&show_comments=false&visual=true';
    document.querySelector('header').appendChild(scIframe);
    const scScript = document.createElement('script');
    scScript.src = 'https://w.soundcloud.com/player/api.js';
    scScript.onload = () => {
      try {
        scWidget = SC.Widget(scIframe);
        scWidget.bind(SC.Widget.Events.READY, () => {
          scReady = true;
          document.getElementById('playerControls').style.display = 'flex';
          scWidget.setVolume(45);
          if (gameStarted) scWidget.play();
        });
        scWidget.bind(SC.Widget.Events.PLAY, () => { scPlaying = true; });
        scWidget.bind(SC.Widget.Events.PAUSE, () => { scPlaying = false; });
      } catch (e) {
        console.warn('SC init', e);
      }
    };
    document.body.appendChild(scScript);
  }

  document.getElementById('musicToggle').addEventListener('click', () => {
    const pc = document.getElementById('playerControls');
    pc.style.display = (pc.style.display === 'flex') ? 'none' : 'flex';
    musicToggle.textContent = (pc.style.display === 'flex') ? 'Скрыть плеер' : 'Плеер';
  });
  document.getElementById('playBtn').addEventListener('click', () => {
    if (scReady) scWidget.play();
    else if (bgm) bgm.play();
    else alert('Музыка не настроена.');
  });
  document.getElementById('pauseBtn').addEventListener('click', () => {
    if (scReady) scWidget.pause();
    else if (bgm) bgm.pause();
  });
  document.getElementById('stopBtn').addEventListener('click', () => {
    if (scReady) { scWidget.seekTo(0); scWidget.pause(); }
    else if (bgm) { bgm.pause(); bgm.currentTime = 0; }
  });
  document.getElementById('volRange').addEventListener('input', (e) => {
    const v = parseInt(e.target.value, 10);
    if (scReady) scWidget.setVolume(v);
    if (bgm) bgm.volume = v / 100;
  });

  const gameArea = document.getElementById('gameArea');
  const scoreEl = document.getElementById('score');
  const leftEl = document.getElementById('left');
  const restartBtn = document.getElementById('restartGame');
  let score = 0, hearts = [], spawnTimer = null, gameRunning = false, spawnedCount = 0;

  function spawnHeart() {
    spawnedCount++;
    const remainingNeeded = Math.max(0, GAME_TARGET - score);
    const isLastSpecial = remainingNeeded === 1;
    const el = document.createElement('div');
    el.className = 'heart';
    el.style.left = (10 + Math.random() * 80) + '%';
    if (isLastSpecial) {
      el.classList.add('gold');
      el.innerHTML = '💖';
    } else {
      el.innerHTML = ['❤️', '💗', '💞'][Math.floor(Math.random() * 3)];
    }
    const startY = -30;
    let top = startY;
    el.style.top = top + 'px';
    gameArea.appendChild(el);
    hearts.push(el);
    let speed = 0.8 + Math.random() * 1.4;
    function fall() {
      top += speed;
      el.style.top = top + 'px';
      if (top > gameArea.clientHeight + 60) {
        el.remove();
        hearts = hearts.filter(h => h !== el);
        return;
      }
      requestAnimationFrame(fall);
    }
    requestAnimationFrame(fall);
    el.addEventListener('click', (ev) => {
      playPop();
      showFloatingWord(ev.clientX, ev.clientY);
      score++;
      scoreEl.textContent = score;
      leftEl.textContent = Math.max(0, GAME_TARGET - score);
      el.style.transform = 'scale(1.5) rotate(-12deg)';
      setTimeout(() => el.remove(), 200);
      hearts = hearts.filter(h => h !== el);
      checkGameWin();
    });
  }

  function startGame() {
    score = 0;
    spawnedCount = 0;
    scoreEl.textContent = '0';
    leftEl.textContent = GAME_TARGET;
    gameRunning = true;
    spawnTimer = setInterval(() => {
      spawnHeart();
      if (Math.random() > 0.66) spawnHeart();
    }, 700);
    setTimeout(() => {
      if (gameRunning) stopGame();
    }, 45000);
  }

  function stopGame() {
    gameRunning = false;
    clearInterval(spawnTimer);
    hearts.forEach(h => h.remove());
    hearts = [];
  }

  function checkGameWin() {
    if (score >= GAME_TARGET) {
      stopGame();
      setTimeout(() => { show('secret'); }, 550);
    }
  }

  restartBtn.addEventListener('click', () => {
    stopGame();
    startGame();
  });

  const observer = new MutationObserver((m) => {
    if (document.getElementById('game').classList.contains('active') && !gameRunning) {
      startGame();
    }
  });
  observer.observe(document.getElementById('game'), { attributes: true });

  let audioCtx = null;
  function ensureAudioCtx() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
  }
  function playPop() {
    try {
      ensureAudioCtx();
      const t = audioCtx.currentTime;
      const o = audioCtx.createOscillator();
      const g = audioCtx.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(600, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.18, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
      o.connect(g);
      g.connect(audioCtx.destination);
      o.start(t);
      o.stop(t + 0.22);
    } catch (e) { }
  }

  function showFloatingWord(x, y) {
    const w = document.createElement('div');
    w.className = 'wordPopup';
    w.textContent = FLOATING_WORDS[Math.floor(Math.random() * FLOATING_WORDS.length)];
    document.body.appendChild(w);
    w.style.left = x + 'px';
    w.style.top = y + 'px';
    requestAnimationFrame(() => {
      w.style.opacity = 1;
      w.style.transform = 'translate(-50%,-30px)';
    });
    setTimeout(() => {
      w.style.opacity = 0;
      w.style.transform = 'translate(-50%,-70px)';
      setTimeout(() => w.remove(), 600);
    }, 900);
  }

  document.getElementById('secretCheck').addEventListener('click', () => {
    const v = document.getElementById('secretInput').value.trim().toLowerCase();
    const msg = document.getElementById('secretMsg');
    if (v === SECRET_ANSWER && v.length) {
      msg.textContent = 'Верно! Перехожу к следующему...';
      setTimeout(() => show('password'), 800);
    } else {
      msg.textContent = 'Не тот ответ. Подумай ещё :)';
    }
  });

  document.getElementById('passCheck').addEventListener('click', () => {
    const v = document.getElementById('passInput').value.trim().toLowerCase();
    const msg = document.getElementById('passMsg');
    if (v === KNOWN_PASSWORD && v.length) {
      msg.textContent = 'Пароль верный!';
      setTimeout(() => {
        startCountdown(COUNTDOWN_SECONDS, () => {
          show('reveal');
          startTypewriter();
        });
      }, 700);
    } else {
      msg.textContent = 'Неправильный пароль.';
    }
  });

  const countValEl = document.getElementById('countValue');
  const skipBtn = document.getElementById('skipTimer');
  let countdownInterval = null;
  function startCountdown(seconds, cb) {
    show('countdown');
    let s = seconds;
    countValEl.textContent = s;
    if (countdownInterval) clearInterval(countdownInterval);
    countdownInterval = setInterval(() => {
      s--;
      if (s <= 0) {
        clearInterval(countdownInterval);
        countdownInterval = null;
        cb();
      } else {
        countValEl.textContent = s;
      }
    }, 1000);
  }
  skipBtn.addEventListener('click', () => {
    if (countdownInterval) {
      clearInterval(countdownInterval);
      countdownInterval = null;
      show('reveal');
      startTypewriter();
    }
  });

  const typeEl = document.getElementById('typewriter');
  const revealText = 'Я хотел сказать тебе кое-что...\nКаждый день с тобой — это маленькое чудо. Ты — моё вдохновение.';
  function startTypewriter() {
    typeEl.textContent = '';
    let i = 0;
    function tick() {
      const ch = revealText[i++];
      if (ch === '\n') typeEl.innerHTML += '<br/>';
      else typeEl.innerHTML += ch;
      if (i < revealText.length) {
        setTimeout(tick, 42 + Math.random() * 40);
      } else {
        setTimeout(() => { show('final'); }, 900);
      }
    }
    tick();
  }

  const yesBtn = document.getElementById('yesBtn');
  const noBtn = document.getElementById('noBtn');
  const messages = ['Точно нет? 😢', 'Подумай ещё…', 'Ну пожааалуйста 💔', 'Я старался…', 'Последний шанс 🥺'];
  let messageIndex = 0, yesScale = 1;
  function handleNoClick() {
    const headerRect = document.querySelector('.page').getBoundingClientRect();
    const nx = headerRect.left + 40 + Math.random() * (headerRect.width - 80);
    const ny = headerRect.top + 40 + Math.random() * (headerRect.height - 80);
    noBtn.style.position = 'fixed';
    noBtn.style.left = nx + 'px';
    noBtn.style.top = ny + 'px';
    noBtn.textContent = messages[messageIndex];
    messageIndex = (messageIndex + 1) % messages.length;
    yesScale *= 1.25;
    yesBtn.style.transform = `scale(${yesScale})`;
    yesBtn.style.boxShadow = '0 10px 30px rgba(255,59,107,0.22)';
    setTimeout(() => yesBtn.style.transform = `scale(${Math.max(1, yesScale - 0.06)})`, 180);
  }
  noBtn.addEventListener('click', handleNoClick);

  const confettiCanvas = document.getElementById('confettiCanvas');
  const ctx = confettiCanvas.getContext && confettiCanvas.getContext('2d');
  let confettiPieces = [];
  function resizeConfetti() {
    confettiCanvas.width = window.innerWidth;
    confettiCanvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resizeConfetti);
  resizeConfetti();
  function spawnConfetti(count) {
    if (!ctx) return;
    confettiCanvas.style.display = 'block';
    for (let i = 0; i < count; i++) {
      confettiPieces.push({
        x: Math.random() * confettiCanvas.width,
        y: -10 - Math.random() * 100,
        vx: (Math.random() - 0.5) * 6,
        vy: 2 + Math.random() * 4,
        r: (Math.random() * 8) + 4,
        color: ['#ff4d6d', '#ffd166', '#ffb3c6', '#ff7aa2'][Math.floor(Math.random() * 4)],
        rot: Math.random() * 360,
        vr: (Math.random() - 0.5) * 8
      });
    }
    if (!confettiLoop) confettiLoop = requestAnimationFrame(confettiTick);
  }
  let confettiLoop = null;
  function confettiTick() {
    ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
    for (let i = 0; i < confettiPieces.length; i++) {
      const p = confettiPieces[i];
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.06;
      p.rot += p.vr;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot * Math.PI / 180);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 0.6);
      ctx.restore();
      if (p.y > confettiCanvas.height + 50) {
        confettiPieces.splice(i, 1);
        i--;
      }
    }
    if (confettiPieces.length) confettiLoop = requestAnimationFrame(confettiTick);
    else {
      cancelAnimationFrame(confettiLoop);
      confettiLoop = null;
      confettiCanvas.style.display = 'none';
    }
  }

  yesBtn.addEventListener('click', () => {
    spawnConfetti(160);
    playPop();
    setTimeout(() => {
      show('slideshow');
      startSlideshow();
      document.getElementById('letter').classList.add('visible');
    }, 420);
  });

  const slides = document.getElementById('slides');
  const dotsWrap = document.getElementById('dots');
  const slideCount = slides.children.length;
  let cur = 0, slideTimer = null;
  function buildDots() {
    dotsWrap.innerHTML = '';
    for (let i = 0; i < slideCount; i++) {
      const d = document.createElement('div');
      d.className = 'dot';
      d.dataset.i = i;
      d.addEventListener('click', () => goTo(i));
      dotsWrap.appendChild(d);
    }
    dotsWrap.children[0].classList.add('active');
  }
  function updateDots() {
    Array.from(dotsWrap.children).forEach((d, idx) => d.classList.toggle('active', idx === cur));
  }
  function goTo(i) {
    cur = (i + slideCount) % slideCount;
    slides.style.transform = `translateX(-${cur * 100}%)`;
    updateDots();
  }
  function startSlideshow() {
    if (slideTimer) return;
    buildDots();
    slideTimer = setInterval(() => { goTo(cur + 1); }, 3600);
  }

  document.getElementById('startBtn').addEventListener('click', () => {
    gameStarted = true;
    show('game');
    startGame();
    if (scReady) { try { scWidget.play(); } catch (e) { } }
    else if (bgm) { try { bgm.play(); } catch (e) { } }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() === 'k') {
      document.getElementById('secretInput').value = SECRET_ANSWER;
      document.getElementById('passInput').value = KNOWN_PASSWORD;
    }
  });
  </script>
</body>
</html>